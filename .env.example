# Safe local-development shape. Copy to `.env.local`, then replace each angle-
# bracket placeholder with the actual local EVM value. Do not add live keys or
# addresses to this file.

APP_ENV=local
CHAIN_FAMILY=local
MONAD_CHAIN_ID=<LOCAL_EVM_CHAIN_ID>
MONAD_RPC_URL=<LOCAL_EVM_RPC_URL>

# Optional locally. Preview, staging, and production require HTTPS explorer and
# RPC URLs, SOURCE_COMMIT, and a deployment manifest matching the environment,
# chain family, chain ID, and source commit.
MONAD_RPC_FALLBACK_URL=
MONAD_EXPLORER_URL=
SOURCE_COMMIT=
DEPLOYMENT_MANIFEST_JSON=

# Contract and token addresses must exist only inside DEPLOYMENT_MANIFEST_JSON.
# NEXT_PUBLIC_* variables are prohibited; the server creates a safe public view.
