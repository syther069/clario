# ==============================================================================
# Clario Protocol — Canonical Environment Variable Schema (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Fill in your provider keys and local/testnet parameters.
# NEVER commit `.env.local` or any secrets to source control.
# ==============================================================================

# Core Application & Network Settings
APP_ENV=local
CHAIN_FAMILY=monad
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_RPC_FALLBACK_URL=
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# Deployment & Source Integrity
SOURCE_COMMIT=
DEPLOYMENT_MANIFEST_JSON=

# Privy Web3 / Non-Custodial Authentication
NEXT_PUBLIC_PRIVY_APP_ID=

# Supabase Storage & Persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Multi-Chain Transaction Ingestion (Alchemy)
ALCHEMY_API_KEY=

# AI Receipt Extraction & Copilot Intelligence (Google Gemini)
GEMINI_API_KEY=
